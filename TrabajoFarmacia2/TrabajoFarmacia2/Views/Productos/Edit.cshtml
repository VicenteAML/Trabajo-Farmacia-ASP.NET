@model TrabajoFarmacia2.Models.Medicamento

@{
    ViewBag.Title = "Editar Medicamento";
}

<h2>✏️ Editar Medicamento</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.Id)

    @Html.ValidationSummary(false, "⚠️ Por favor corrige los siguientes errores:", new { @class = "validation-summary-errors" })

    <div class="form-group">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(m => m.Nombre)
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "field-validation-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Precio)
        @Html.TextBoxFor(m => m.Precio, new { type = "number", step = "0.01" })
        @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "field-validation-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Stock)
        @Html.TextBoxFor(m => m.Stock, new { type = "number" })
        @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "field-validation-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Descripcion)
        @Html.TextAreaFor(m => m.Descripcion, new { rows = 3 })
        @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "field-validation-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaVencimiento)
        @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { type = "date" })
        @Html.ValidationMessageFor(m => m.FechaVencimiento, "", new { @class = "field-validation-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Marca)
        @Html.TextBoxFor(m => m.Marca)
        @Html.ValidationMessageFor(m => m.Marca, "", new { @class = "field-validation-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Laboratorio)
        @Html.TextBoxFor(m => m.Laboratorio)
        @Html.ValidationMessageFor(m => m.Laboratorio, "", new { @class = "field-validation-error" })
    </div>

    <div style="margin-top: 20px; display: flex; gap: 10px; align-items: center;">
        <input type="submit" value="💾 Guardar Cambios" />
        @Html.ActionLink("✖ Cancelar", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}