@model IEnumerable<TrabajoFarmacia2.Models.Producto>

<h2>Productos de Farmacia</h2>

<p>@Html.ActionLink("Agregar Producto", "Create")</p>

@if (Model.Any())
{
    <table border="1">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.Precio</td>
                <td>@producto.Stock</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = producto.Id }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = producto.Id }, new { onclick = "return confirm('¿Eliminar este producto?');" })
                </td>
            </tr>
        }
    </table>
}
else
{
    <p>No hay productos en la base de datos.</p>
    <p>@Html.ActionLink("Agregar Producto", "Create")</p>
}