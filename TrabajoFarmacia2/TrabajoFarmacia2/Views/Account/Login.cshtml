@model TrabajoFarmacia2.Models.Usuario

<div class="form-container">
    <h2>Iniciar Sesion - FarmaSystem</h2>

    @if (ViewBag.Error != null)
    {
        <div class="validation-summary">
            @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

        <div class="form-group">
            @Html.LabelFor(m => m.Username, "Usuario")
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Password, "Contrasena")
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
        </div>

        <div class="form-actions">
            <input type="submit" value="Ingresar" class="btn-guardar" />
        </div>
    }
</div>