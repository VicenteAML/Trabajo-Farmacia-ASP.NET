<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Farmacia</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .navbar {
            background-color: #2c7da0;
            overflow: hidden;
            position: sticky;
            top: 0;
        }

            .navbar a {
                float: left;
                display: block;
                color: white;
                text-align: center;
                padding: 14px 20px;
                text-decoration: none;
                font-size: 17px;
            }

                .navbar a:hover {
                    background-color: #61a5c2;
                    color: white;
                }

                .navbar a.active {
                    background-color: #014f86;
                }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 20px;
            background-color: white;
            min-height: 80vh;
        }

        .footer {
            background-color: #2c7da0;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 20px;
        }

        @@media screen and (max-width: 600px) {
            .navbar a {
                float: none;
                display: block;
                text-align: left;
            }
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid #ddd;
        }

        th, td {
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #2c7da0;
            color: white;
        }

        input[type="submit"], .btn {
            background-color: #2c7da0;
            color: white;
            padding: 8px 15px;
            border: none;
            cursor: pointer;
        }

            input[type="submit"]:hover, .btn:hover {
                background-color: #014f86;
            }
    </style>
</head>
<body>

    <div class="navbar">
        <a href="@Url.Action("Index", "Home")">Inicio</a>
        <a href="@Url.Action("Catalogo", "Home")">Catálogo</a>
        <a href="@Url.Action("Contacto", "Home")">Contacto</a>
        <a href="@Url.Action("Index", "Productos")">Administración</a>
    </div>

    <div class="container">
        @RenderBody()
    </div>

    <div class="footer">
        <p>Farmacia - Sistema Web &copy; @DateTime.Now.Year</p>
    </div>

</body>
</html>
