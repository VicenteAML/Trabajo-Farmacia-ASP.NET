<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FarmaSystem</title>
    <style>
        .validation-summary-valid {
            display: none;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #eaf4fb;
            color: #333;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #014f86, #2c7da0);
            overflow: hidden;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
        }

            .navbar .brand {
                color: white;
                font-size: 20px;
                font-weight: bold;
                padding: 14px 24px;
                text-decoration: none;
                letter-spacing: 1px;
            }

                .navbar .brand span {
                    color: #a9d6e5;
                }

            .navbar a {
                float: left;
                display: block;
                color: rgba(255,255,255,0.85);
                text-align: center;
                padding: 14px 20px;
                text-decoration: none;
                font-size: 15px;
                transition: background 0.3s, color 0.3s;
            }

                .navbar a:hover {
                    background-color: rgba(255,255,255,0.15);
                    color: white;
                }

                .navbar a.active {
                    background-color: rgba(0,0,0,0.2);
                    color: white;
                    border-bottom: 3px solid #a9d6e5;
                }

            .navbar .nav-user {
                margin-left: auto;
                display: flex;
                align-items: center;
            }

                .navbar .nav-user span {
                    color: rgba(255,255,255,0.85);
                    padding: 14px 10px;
                    font-size: 15px;
                }

        /* ===== CONTAINER ===== */
        .container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 30px;
            background-color: white;
            min-height: 75vh;
            border-radius: 10px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        }

        /* ===== HEADINGS ===== */
        h2 {
            color: #014f86;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid #a9d6e5;
            font-size: 1.6rem;
        }

        /* ===== TABLES ===== */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

            table th, table td {
                padding: 12px 15px;
                text-align: left;
                border-bottom: 1px solid #dee2e6;
            }

            table th {
                background: linear-gradient(135deg, #014f86, #2c7da0);
                color: white;
                font-weight: 600;
                letter-spacing: 0.5px;
            }

            table tr:hover {
                background-color: #eaf4fb;
                transition: background 0.2s;
            }

            table tr:nth-child(even) {
                background-color: #f8fbfd;
            }

        /* ===== BUTTONS ===== */
        input[type="submit"], .btn {
            background: linear-gradient(135deg, #2c7da0, #014f86);
            color: white;
            padding: 9px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
            box-shadow: 0 2px 6px rgba(1,79,134,0.3);
        }

            input[type="submit"]:hover, .btn:hover {
                background: linear-gradient(135deg, #014f86, #01283f);
                box-shadow: 0 4px 12px rgba(1,79,134,0.4);
                transform: translateY(-1px);
            }

        .btn-danger {
            background: linear-gradient(135deg, #c0392b, #96281b);
        }

            .btn-danger:hover {
                background: linear-gradient(135deg, #96281b, #6e1a10);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #6c757d, #495057);
        }

        /* ===== FORMS ===== */
        .form-group {
            margin-bottom: 18px;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                color: #014f86;
                margin-bottom: 5px;
                font-size: 14px;
            }

            .form-group input[type="text"],
            .form-group input[type="number"],
            .form-group input[type="date"],
            .form-group textarea {
                width: 100%;
                max-width: 400px;
                padding: 9px 12px;
                border: 2px solid #c8dce8;
                border-radius: 6px;
                font-size: 14px;
                transition: border-color 0.3s, box-shadow 0.3s;
                background-color: #fafcfe;
            }

                .form-group input:focus,
                .form-group textarea:focus {
                    outline: none;
                    border-color: #2c7da0;
                    box-shadow: 0 0 0 3px rgba(44,125,160,0.15);
                    background-color: white;
                }

        /* ===== VALIDATION ===== */
        .validation-summary-errors {
            background-color: #fff3f3;
            border: 1px solid #f5c6cb;
            border-left: 5px solid #e74c3c;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #c0392b;
            font-weight: 500;
        }

        .field-validation-error {
            color: #e74c3c;
            font-size: 12px;
            margin-left: 5px;
            display: block;
            margin-top: 3px;
        }

        .input-validation-error {
            border-color: #e74c3c !important;
            background-color: #fff8f8 !important;
        }

        /* ===== LOGIN FORM ===== */
        .form-container {
            max-width: 400px;
            margin: 40px auto;
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        }

        /* ===== FOOTER ===== */
        .footer {
            background: linear-gradient(135deg, #014f86, #2c7da0);
            color: rgba(255,255,255,0.9);
            text-align: center;
            padding: 18px;
            margin-top: 10px;
            font-size: 14px;
        }

            .footer span {
                color: #a9d6e5;
            }

        /* ===== RESPONSIVE ===== */
        @@media screen and (max-width: 768px) {
            .navbar {
                flex-wrap: wrap;
            }

                .navbar .brand {
                    width: 100%;
                    text-align: center;
                    padding: 10px;
                }

                .navbar a {
                    float: none;
                    flex: 1 1 auto;
                    text-align: center;
                    font-size: 13px;
                    padding: 10px 8px;
                }

                .navbar .nav-user {
                    width: 100%;
                    justify-content: center;
                    margin-left: 0;
                }

            .container {
                margin: 10px;
                padding: 15px;
                border-radius: 6px;
            }

            table th, table td {
                padding: 8px 10px;
                font-size: 13px;
            }
        }

        @@media screen and (max-width: 480px) {
            h2 {
                font-size: 1.3rem;
            }

            .navbar a {
                font-size: 12px;
                padding: 8px 5px;
            }
        }
    </style>
</head>
<body>

    <div class="navbar">
        <a class="brand" href="@Url.Action("Index", "Home")">&#128138; Farma<span>System</span></a>
        <a href="@Url.Action("Index", "Home")">Inicio</a>
        <a href="@Url.Action("Catalogo", "Home")">Catalogo</a>
        <a href="@Url.Action("Contacto", "Home")">Contacto</a>
        <a href="@Url.Action("Index", "Productos")">Administracion</a>

        <div class="nav-user">
            @if (Session["UsuarioLogueado"] != null)
            {
                <span>| Hola, @Session["UsuarioLogueado"]</span>
                <a href="@Url.Action("Logout", "Account")">Cerrar Sesion</a>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")">Login</a>
            }
        </div>
    </div>

    <div class="container">
        @RenderBody()
    </div>

    <div class="footer">
        <p>&#128138; FarmaSystem &mdash; Sistema de Gestion Web &copy; @DateTime.Now.Year | Desarrollado con <span>&#9829;</span> en ASP.NET</p>
    </div>

    @* Scripts necesarios para validacion del lado del cliente *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
